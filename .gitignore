# =========================================================================
# ShopWave Root .gitignore
# =========================================================================

# Compiled Java class files
*.class
**/*.class

# Maven build directories
target/
**/target/
!**/src/main/**/target/
!**/src/test/**/target/

# Gradle build directories
build/
**/build/
!**/src/main/**/build/
!**/src/test/**/build/
.gradle/
**/.gradle/

# Log files & log directories
logs/
**/logs/
*.log
**/*.log

# Node & Frontend dependencies and artifacts
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
**/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IntelliJ IDEA
.idea/
**/.idea/
*.iws
*.iml
*.ipr
out/
**/out/

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# Visual Studio Code
.vscode/
**/.vscode/

# OS metadata & temporary files
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak

